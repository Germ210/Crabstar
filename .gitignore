# Rust/Cargo
target/
**/*.rs.bk

# Cargo package files
Cargo.lock

# Executables
*.exe
*.dll
*.so
*.dylib

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Logs and temp files
*.log
*.tmp
*.temp

# OS-specific
.DS_Store
Thumbs.db

# Git LFS placeholder (if you ever need it)
*.psd filter=lfs diff=lfs merge=lfs -text

